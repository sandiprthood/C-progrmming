#include <stdio.h>
int main(void) {
int a[4][4] = {0};
int edges[][2] = {{0,1}, {1,2}, {2,3}};
int i, j;
for (i = 0; i < 3; i++) {
int u = edges[i][0], v = edges[i][1]; a[u][v] = 1;
a[v][u] = 1;
}
printf("Adjacency matrix:\n"); for (i = 0; i < 4; i++) {
for (j = 0; j < 4; j++) printf("%d ", a[i][j]);
printf("\n");
}
return 0;
}
