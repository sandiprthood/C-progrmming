#include <stdio.h>
#include <stdlib.h>
typedef struct Node { int data; struct Node *next; } Node;
int main(void) {
int values[] = {10, 20, 30}, i;
Node *head = NULL, *tail = NULL, *p, *t;
for (i = 0; i < 3; i++) {
p = (Node *)malloc(sizeof(Node));
if (!p) return 1;
p->data = values[i]; p->next = NULL; if (head == NULL) head = p;
else tail->next = p; tail = p;
}
printf("Linked list: ");
for (t = head; t != NULL; t = t->next) printf("%d ", t->data);
printf("\n");
while (head) { t = head; head = head->next; free(t); } return 0;
}
