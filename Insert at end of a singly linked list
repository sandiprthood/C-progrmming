#include <stdio.h>
#include <stdlib.h>
typedef struct Node { int data; struct Node *next; } Node;
int main(void) {
int values[] = {10, 20, 30}, i;
Node *head = NULL, *tail = NULL, *p, *temp;
for (i = 0; i < 3; i++) {
p = (Node *)malloc(sizeof(Node));
if (!p) return 1;
p->data = values[i]; p->next = NULL;
if (!head) head = p; else tail->next = p; tail = p;
}
p = (Node *)malloc(sizeof(Node));
if (!p) return 1;
p->data = 40; p->next = NULL; tail->next = p;
printf("List: ");
for (temp = head; temp; temp = temp->next) printf("%d ", temp->data);
printf("\n");
while (head) { temp = head; head = head->next; free(temp); } return 0;
}
