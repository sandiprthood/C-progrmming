#include <stdio.h>
int main(void) {
int times[] = {52, 38, 75, 41, 63};
int n = 5, i, j, key;
for (i = 1; i < n; i++) { key = times[i];
j = i - 1;
while (j >= 0 && times[j] > key) { times[j + 1] = times[j];
j--;
}
times[j + 1] = key;
}
printf("Race times (shortest to longest): "); for (i = 0; i < n; i++) printf("%d ", times[i]); printf("\n");
return 0;
}
