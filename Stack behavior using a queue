#include <stdio.h>
#define MAX 10
int q[MAX], front = 0, rear = -1, count = 0;
void stackPush(int x) { int i;
rear = (rear + 1) % MAX; q[rear] = x; count++;
for (i = 0; i < count - 1; i++) { int v = q[front];
front = (front + 1) % MAX; rear = (rear + 1) % MAX; q[rear] = v;
}
}
int stackPop(void) { int v = q[front];
front = (front + 1) % MAX; count--;
return v;
}
int main(void) {
stackPush(4); stackPush(8); stackPush(12); printf("Removed most recent item: %d\n", stackPop()); printf("Remaining (top to bottom): ");
while (count > 0) printf("%d ", stackPop());
printf("\n"); return 0;
}
