#include <stdio.h>
int main(void) {
int a[] = {9, 5, 7, 1, 3};
int n = 5, i, j, temp;
for (i = 0; i < n - 1; i++) {
for (j = 0; j < n - 1 - i; j++) {
if (a[j] > a[j + 1]) { temp = a[j];
a[j] = a[j + 1]; a[j + 1] = temp;
}
}
}
printf("Sorted array: ");
for (i = 0; i < n; i++) printf("%d ", a[i]);
printf("\n"); return 0;
}
