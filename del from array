#include <stdio.h>
int main(void) {
int a[] = {5, 15, 25, 35, 45};
int n = 5, pos = 2, i;
if (pos < 1 || pos > n) { printf("Invalid position\n"); return 0;
}
for (i = pos - 1; i < n - 1; i++) a[i] = a[i + 1];
n--;
printf("Updated array: ");
for (i = 0; i < n; i++) printf("%d ", a[i]);
printf("\n"); return 0;
}
