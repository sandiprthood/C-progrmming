#include <stdio.h>
int main(void) {
int a[] = {8, 3, 6, 1, 5};
int n = 5, i, j, key;
for (i = 1; i < n; i++) { key = a[i];
j = i - 1;
while (j >= 0 && a[j] > key) { a[j + 1] = a[j];
j--;
}
a[j + 1] = key;
}
printf("Sorted array: ");
for (i = 0; i < n; i++) printf("%d ", a[i]);
printf("\n"); return 0;
}
