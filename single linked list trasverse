#include <stdio.h> #include <stdlib.h> typedef struct Node {
int data;
struct Node *next;
} Node;
int main(void) {
int values[] = {4, 8, 12, 16}, i, found = 0; Node *head = NULL, *tail = NULL, *p, *temp; for (i = 0; i < 4; i++) {
p = (Node *)malloc(sizeof(Node));
if (!p) return 1;
p->data = values[i]; p->next = NULL;
if (!head) head = p; else tail->next = p; tail = p;
}
printf("List: ");
for (temp = head; temp != NULL; temp = temp->next) { printf("%d ", temp->data);
if (temp->data == 12) found = 1;
}
printf("\n12 %s\n", found ? "found" : "not found");
while (head) { temp = head; head = head->next; free(temp); } return 0;
}
