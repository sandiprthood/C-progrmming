#include <stdio.h>
#define MAX 4
int stack[MAX], top = -1;
void push(int x) {
if (top == MAX - 1) { printf("Overflow: cannot push %d\n", x); return; } stack[++top] = x;
printf("Pushed %d\n", x);
}
void pop(void) {
if (top == -1) { printf("Underflow: stack is empty\n"); return; } printf("Popped %d\n", stack[top--]);
}
void display(void) { int i;
if (top == -1) { printf("Stack is empty\n"); return; } printf("Stack (top to bottom): ");
for (i = top; i >= 0; i--) printf("%d ", stack[i]);
printf("\n");
}
int main(void) {
push(8); push(16); push(24); push(32); push(40); display();
while (top != -1) pop(); pop();
display();
return 0;
}
