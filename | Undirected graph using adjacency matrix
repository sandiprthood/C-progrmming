#include <stdio.h>
int main(void) {
int a[5][5] = {0};
int edges[][2] = {{0,2}, {0,4}, {1,3}, {2,3}, {3,4}};
int i, j;
for (i = 0; i < 5; i++) {
int u = edges[i][0], v = edges[i][1]; a[u][v] = 1;
a[v][u] = 1;
}
printf("Adjacency matrix:\n"); for (i = 0; i < 5; i++) {
for (j = 0; j < 5; j++) printf("%d ", a[i][j]);
printf("\n");
}
return 0;
}
